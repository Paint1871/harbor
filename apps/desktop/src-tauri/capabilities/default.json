{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local main window only. Files are restricted to host-granted roots. Process creation stays in Rust behind ExecutableAllowlist; no renderer shell commands are enabled.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "allow-settings-get",
    "allow-settings-set",
    "allow-engines-detect",
    "allow-engines-recheck",
    "allow-workspace-list",
    "allow-workspace-add",
    "allow-workspace-remove",
    "allow-workspace-pin",
    "allow-thread-list",
    "allow-thread-create",
    "allow-thread-rename",
    "allow-thread-delete",
    "allow-thread-pin",
    "allow-thread-send",
    "allow-thread-cancel",
    "allow-thread-grant-root",
    "allow-thread-attach-files",
    "allow-acp-permission-resolve",
    "allow-git-diff",
    "allow-agent-list",
    "allow-agent-create",
    "allow-agent-update",
    "allow-agent-delete",
    "allow-layout-restore",
    "allow-workspace-tidy",
    "allow-workspace-save-layout",
    "allow-pane-create",
    "allow-pane-close",
    "allow-pty-spawn",
    "allow-pty-write-b64",
    "allow-pty-resize",
    "allow-pty-pause",
    "allow-pty-resume",
    "allow-pty-kill",
    "allow-fs-read",
    "allow-fs-write",
    "allow-fs-list",
    "allow-updater-check",
    "allow-plugin-list",
    "allow-plugin-connect",
    "allow-plugin-disconnect",
    "allow-dictation-begin",
    "allow-dictation-end",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    { "identifier": "fs:scope", "allow": [] },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://github.com/**" },
        { "url": "https://api.github.com/**" }
      ]
    },
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text"
  ]
}
